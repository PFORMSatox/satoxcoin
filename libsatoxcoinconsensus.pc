prefix=/home/pform/projects/satoxcoin/depends/x86_64-pc-linux-gnu
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Satoxcoin Core consensus library
Description: Library for the Satoxcoin consensus protocol.
